# ─── File Data Source ───

DATA_PATH = _os.path.abspath(DATABASE_URL or ".")
# Single-file mode: DATABASE_URL may point directly at a CSV/TSV/JSON/JSONL file
DATA_DIR = _os.path.dirname(DATA_PATH) if _os.path.isfile(DATA_PATH) else DATA_PATH

def _safe_filepath(filename: str) -> str:
    path = _os.path.abspath(_os.path.join(DATA_DIR, filename))
    # _os.path.commonpath behaves safely if both are absolute
    if not _os.path.commonpath([DATA_DIR, path]) == DATA_DIR:
        raise ValueError(f"Path traversal detected: {filename}")
    return path


def _load_rows(filename: str, field_map: dict) -> list[dict]:
    """Load a data file as a list of dicts keyed by safe column names.

    field_map maps safe column name -> original header/key in the file.
    """
    filepath = _safe_filepath(filename)
    if not _os.path.exists(filepath):
        return []
    ext = _os.path.splitext(filename)[1].lower()

    raw_rows: list[dict] = []
    if ext in (".csv", ".tsv"):
        delimiter = "\t" if ext == ".tsv" else ","
        with open(filepath, "r", encoding="utf-8-sig", newline="") as f:
            raw_rows = list(csv.DictReader(f, delimiter=delimiter))
    elif ext == ".json":
        with open(filepath, "r", encoding="utf-8") as f:
            data = json.load(f)
        raw_rows = data if isinstance(data, list) else [data]
    elif ext == ".jsonl":
        with open(filepath, "r", encoding="utf-8") as f:
            raw_rows = [json.loads(line) for line in f if line.strip()]

    # Remap original keys to safe column names
    return [
        {safe: row.get(original) for safe, original in field_map.items()}
        for row in raw_rows
        if isinstance(row, dict)
    ]


def _sort_key(value):
    """Sort mixed data numerically when possible, else as strings."""
    if value is None or value == "":
        return (2, "")
    try:
        return (0, float(value))
    except (TypeError, ValueError):
        return (1, str(value).lower())

