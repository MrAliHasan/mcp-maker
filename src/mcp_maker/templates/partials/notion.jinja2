def _normalize_{{ table.name }}(page: dict) -> dict:
    """Convert a Notion page to a flat dict with safe property names."""
    result = {"page_id": page.get("id", "")}
    props = page.get("properties", {})
    for safe_name, original_name in _{{ table.name }}_props.items():
        if original_name in props:
            result[safe_name] = _extract_notion_value(props[original_name])
        else:
            result[safe_name] = None
    return result



{% if 'read' in tbl_ops %}
@mcp.tool()
def list_{{ table.name }}(limit: int = {{ default_limit }}, start_cursor: str | None = None, sort_property: str | None = None, sort_direction: str = "ascending", fields: str | None = None) -> dict:
    """List pages from the '{{ table.description }}' Notion database.

    Args:
        limit: Maximum pages (default: {{ default_limit }}, max: {{ max_limit }}).
        start_cursor: Pagination cursor from previous results.
        sort_property: Property name to sort by.
        sort_direction: 'ascending' or 'descending' (default: 'ascending').
        fields: Comma-separated property names to return (default: all).

    Returns:
        Dict with 'results' (list of pages), 'has_more', and 'next_cursor' for pagination.
    """
    limit = min(limit, {{ max_limit }})
    kwargs = {"database_id": DATABASE_IDS["{{ table.name }}"], "page_size": limit}
    if start_cursor:
        kwargs["start_cursor"] = start_cursor
    if sort_property:
        original_name = _{{ table.name }}_props.get(sort_property, sort_property)
        direction = "descending" if sort_direction.lower() == "descending" else "ascending"
        kwargs["sorts"] = [{"property": original_name, "direction": direction}]
    response = notion.databases.query(**kwargs)
    results = [_normalize_{{ table.name }}(p) for p in response.get("results", [])]
    if fields:
        selected = [f.strip() for f in fields.split(",") if f.strip()]
        results = [{k: r.get(k) for k in selected if k in r} for r in results]
    return {
        "results": results,
        "next_cursor": response.get("next_cursor"),
        "has_more": response.get("has_more", False),
    }
{% endif %}



{% if 'read' in tbl_ops %}
@mcp.tool()
def get_{{ table.name }}_by_page_id(page_id: str) -> dict | None:
    """Get a single page from '{{ table.description }}' by its Notion page ID.

    Args:
        page_id: The Notion page ID.
    """
    try:
        # Throttle API requests to prevent 429 Too Many Requests
        _rate_limiter.acquire()
        page = notion.pages.retrieve(page_id=page_id)
        return _normalize_{{ table.name }}(page)
    except Exception:
        return None
{% endif %}



{% if 'read' in tbl_ops %}
@mcp.tool()
def search_{{ table.name }}(query: str, limit: int = {{ default_limit }}) -> list[dict]:
    """Search '{{ table.description }}' for matching pages.

    Args:
        query: Search text (case-insensitive, matches visible text fields).
        limit: Maximum results.
    """
    # Notion's database query doesn't have a direct text search,
    # so we fetch all and filter client-side
    all_pages = []
    has_more = True
    cursor = None
    while has_more and len(all_pages) < 1000:
        result = list_{{ table.name }}(limit=100, start_cursor=cursor)
        all_pages.extend(result["results"])
        has_more = result["has_more"]
        cursor = result.get("next_cursor")

    query_lower = query.lower()
    results = []
    for page in all_pages:
        for value in page.values():
            if value and query_lower in str(value).lower():
                results.append(page)
                break
        if len(results) >= limit:
            break
    return results
{% endif %}


@mcp.tool()
def filter_{{ table.name }}(property_name: str, value: str) -> list[dict]:
    """Filter '{{ table.description }}' by a property value.

    Uses Notion's native filter API for efficient server-side filtering.

    Args:
        property_name: The safe property name to filter by.
        value: The value to match.

    Available properties:
        {% for col in table.columns %}
        {{ col.name }} ({{ col.type.value }}) -> {{ col.description }}
        {% endfor %}
    """
    if property_name not in _{{ table.name }}_props:
        return []
    original_name = _{{ table.name }}_props[property_name]

    # Build a simple equals filter (works for text, select, etc.)
    filter_obj = {
        "property": original_name,
        "rich_text": {"equals": value},
    }

    try:
        # Throttle API requests to prevent 429 Too Many Requests
        _rate_limiter.acquire()
        response = notion.databases.query(
            database_id=DATABASE_IDS["{{ table.name }}"],
            filter=filter_obj,
            page_size=100,
        )
        return [_normalize_{{ table.name }}(p) for p in response.get("results", [])]
    except Exception:
        # Fall back to client-side filter if filter type doesn't match
        all_pages = search_{{ table.name }}(value, limit=100)
        return [
            p for p in all_pages
            if p.get(property_name) and value.lower() in str(p[property_name]).lower()
        ]



{% if 'read' in tbl_ops %}
@mcp.tool()
def count_{{ table.name }}() -> dict:
    """Get the total number of pages in '{{ table.description }}'.

    Counting is capped at 10,000 pages to avoid hammering the Notion API;
    'exact' is False when the cap was hit.
    """
    count = 0
    has_more = True
    cursor = None
    while has_more and count < 10000:
        result = list_{{ table.name }}(limit=100, start_cursor=cursor)
        count += len(result["results"])
        has_more = result["has_more"]
        cursor = result.get("next_cursor")
    return {"count": count, "exact": not has_more}

@mcp.tool()
def distinct_{{ table.name }}(property_name: str, limit: int = 100) -> list:
    """Get the distinct values of a property in '{{ table.description }}'.

    Args:
        property_name: Safe property name (e.g. 'status', 'assignee').
        limit: Maximum distinct values to return.

    Note: computed from up to 1,000 pages — an approximation on
    larger databases.
    """
    if property_name not in _{{ table.name }}_props:
        raise ValueError(f"Invalid property: {property_name}. Available: {', '.join(_{{ table.name }}_props)}")
    seen = []
    fetched = 0
    has_more = True
    cursor = None
    while has_more and fetched < 1000:
        result = list_{{ table.name }}(limit=100, start_cursor=cursor)
        for page in result["results"]:
            fetched += 1
            v = page.get(property_name)
            candidates = v if isinstance(v, list) else [v]
            for c in candidates:
                if c not in seen:
                    seen.append(c)
                    if len(seen) >= limit:
                        return seen
        has_more = result["has_more"]
        cursor = result.get("next_cursor")
    return seen
{% endif %}



