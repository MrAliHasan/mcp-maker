    {% for table in tables %}
{% set tbl_ops = rbac_config.get(table.name | lower, ops) if rbac_config else ops %}
    "{{ table.name }}": "{{ schema.metadata.get('database_map', {}).get(table.name, '') }}",
    {% endfor %}
}

