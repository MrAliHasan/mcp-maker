{% if 'insert' in tbl_ops %}
@mcp.tool()
def create_{{ table.name }}({% for col in table.columns %}{{ col.name }}: str | None = None{{ ', ' if not loop.last else '' }}{% endfor %}) -> dict:
    """Create a new page in '{{ table.description }}'.

    Args:
        {% for col in table.columns %}
        {{ col.name }}: Value for '{{ col.description }}'.
        {% endfor %}

    Returns:
        The created page with its page_id.
    """
    properties = {}
    {% for col in table.columns %}
    if {{ col.name }} is not None:
        properties["{{ col.description }}"] = {"rich_text": [{"text": {"content": str({{ col.name }})}}]}
    {% endfor %}
    # Throttle API requests to prevent 429 Too Many Requests
    _rate_limiter.acquire()
    page = notion.pages.create(
        parent={"database_id": DATABASE_IDS["{{ table.name }}"]},
        properties=properties,
    )
    return _normalize_{{ table.name }}(page)
{% endif %}

{% if 'update' in tbl_ops %}
@mcp.tool()
def update_{{ table.name }}(page_id: str, {% for col in table.columns %}{{ col.name }}: str | None = None{{ ', ' if not loop.last else '' }}{% endfor %}) -> dict | None:
    """Update an existing page in '{{ table.description }}'.

    Args:
        page_id: The Notion page ID to update.
        {% for col in table.columns %}
        {{ col.name }}: New value for '{{ col.description }}'.
        {% endfor %}
    """
    properties = {}
    {% for col in table.columns %}
    if {{ col.name }} is not None:
        properties["{{ col.description }}"] = {"rich_text": [{"text": {"content": str({{ col.name }})}}]}
    {% endfor %}
    if not properties:
        return None
    try:
        _rate_limiter.acquire()
        page = notion.pages.update(page_id=page_id, properties=properties)
        return _normalize_{{ table.name }}(page)
    except Exception as e:
        raise RuntimeError(f"update_{{ table.name }} failed: {e}") from e
{% endif %}

{% if 'delete' in tbl_ops %}
@mcp.tool()
def archive_{{ table.name }}(page_id: str) -> dict:
    """Archive (soft-delete) a page in '{{ table.description }}'.

    Args:
        page_id: The Notion page ID to archive.
    """
    try:
        _rate_limiter.acquire()
        notion.pages.update(page_id=page_id, archived=True)
        return {"archived": True, "page_id": page_id}
    except Exception as e:
        raise RuntimeError(f"archive_{{ table.name }} failed: {e}") from e
{% endif %}

{% endif %}
{% endfor %}
