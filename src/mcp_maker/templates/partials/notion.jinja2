_{{ table.name }}_props = {
    {% for col in table.columns %}
    "{{ col.name }}": "{{ col.description }}",
    {% endfor %}
}
_{{ table.name }}_props_rev = {v: k for k, v in _{{ table.name }}_props.items()}
