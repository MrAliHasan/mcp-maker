import openpyxl

EXCEL_PATH = DATABASE_URL
if EXCEL_PATH and EXCEL_PATH.startswith("excel:///"):
    EXCEL_PATH = EXCEL_PATH[len("excel:///"):]
elif EXCEL_PATH and EXCEL_PATH.startswith("excel://"):
    EXCEL_PATH = EXCEL_PATH[len("excel://"):]

# Pre-load all sheets into memory for fast tool access
_wb = openpyxl.load_workbook(EXCEL_PATH, read_only=True, data_only=True)
_EXCEL_DATA = {}

{% for table in tables %}
{% set tbl_ops = rbac_config.get(table.name | lower, ops) if rbac_config else ops %}
# Rows are keyed by the sanitized column names used in the tool schemas,
# mapped positionally — not by re-reading raw headers at runtime.
_cols = [{% for col in table.columns %}"{{ col.name }}", {% endfor %}]
_rows_iter = _wb["{{ table.description }}"].iter_rows(values_only=True)
next(_rows_iter, None)  # skip header row
_EXCEL_DATA["{{ table.name }}"] = [
    {c: (row[i] if i < len(row) else None) for i, c in enumerate(_cols)}
    for row in _rows_iter
    if any(v is not None for v in row)
]
{% endfor %}

def _xl_sort_key(value):
    """Sort mixed data numerically when possible, else as strings."""
    if value is None or value == "":
        return (2, "")
    try:
        return (0, float(value))
    except (TypeError, ValueError):
        return (1, str(value).lower())

_wb.close()

