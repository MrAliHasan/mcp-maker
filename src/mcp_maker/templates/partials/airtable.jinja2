# Field name mapping for this table
_{{ table.name }}_fields = {
    {% for col in table.columns %}
    "{{ col.name }}": "{{ col.description }}",
    {% endfor %}
}
_{{ table.name }}_fields_rev = {v: k for k, v in _{{ table.name }}_fields.items()}


def _normalize_{{ table.name }}(record: dict) -> dict:
    """Convert an Airtable record to a flat dict with safe field names."""
    fields = record.get("fields", {})
    result = {"record_id": record.get("id", "")}
    for safe_name, original_name in _{{ table.name }}_fields.items():
        result[safe_name] = fields.get(original_name)
    return result


def _to_airtable_{{ table.name }}(data: dict) -> dict:
    """Convert a dict with safe field names back to Airtable field names."""
    fields = {}
    for safe_name, value in data.items():
        if safe_name == "record_id":
            continue
        if value is not None and safe_name in _{{ table.name }}_fields:
            fields[_{{ table.name }}_fields[safe_name]] = value
    return fields



{% if 'read' in tbl_ops %}
@mcp.tool()
def list_{{ table.name }}(
    limit: int = {{ default_limit }},
    offset: int = 0,
    sort_field: str | None = None,
    sort_direction: str = "asc",
    fields: str | None = None,
) -> dict:
    """List records from the '{{ table.description }}' table in Airtable.

    Args:
        limit: Maximum records to return (default: {{ default_limit }}, max: {{ max_limit }}).
        offset: Number of records to skip for pagination.
        sort_field: Field name to sort by (use safe names like 'name', 'email').
        sort_direction: Sort direction — 'asc' or 'desc'.
        fields: Comma-separated field names to return (default: all).

    Returns:
        Dict with 'results', 'total', 'has_more', 'next_offset'.
    """
    limit = min(limit, {{ max_limit }})
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])

    kwargs = {"max_records": offset + limit}
    if sort_field and sort_field in _{{ table.name }}_fields:
        original_field = _{{ table.name }}_fields[sort_field]
        kwargs["sort"] = [original_field] if sort_direction == "asc" else ["-" + original_field]

    records = tbl.all(**kwargs)
    normalized = [_normalize_{{ table.name }}(r) for r in records]
    total = len(normalized)
    rows = normalized[offset:offset + limit]
    if fields:
        selected = [f.strip() for f in fields.split(",") if f.strip()]
        rows = [{k: r.get(k) for k in selected if k in r} for r in rows]
    return {
        "results": rows,
        "total": total,
        "has_more": (offset + limit) < total,
        "next_offset": offset + limit if (offset + limit) < total else None,
    }
{% endif %}



{% if 'read' in tbl_ops %}
@mcp.tool()
def get_{{ table.name }}_by_record_id(record_id: str) -> dict | None:
    """Get a single record from '{{ table.description }}' by its Airtable record ID.

    Args:
        record_id: The Airtable record ID (e.g. 'recXXXXXXXX').
    """
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])
    try:
        # Throttle API requests to prevent 429 Too Many Requests
        _rate_limiter.acquire()
        record = tbl.get(record_id)
        return _normalize_{{ table.name }}(record)
    except Exception:
        return None
{% endif %}



{% if 'read' in tbl_ops %}
@mcp.tool()
def search_{{ table.name }}(query: str, limit: int = {{ default_limit }}) -> list[dict]:
    """Search '{{ table.description }}' by matching against text fields.

    Args:
        query: Search text (case-insensitive, matches any text field).
        limit: Maximum results to return.
    """
    limit = min(limit, {{ max_limit }})
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])
    query_lower = query.lower()
    results = []
    for record in tbl.all(max_records=1000):
        normalized = _normalize_{{ table.name }}(record)
        if any(v is not None and query_lower in str(v).lower() for v in normalized.values()):
            results.append(normalized)
            if len(results) >= limit:
                break
    return results

@mcp.tool()
def distinct_{{ table.name }}(field: str, limit: int = 100) -> list:
    """Get the distinct values of a field in '{{ table.description }}'.

    Args:
        field: Safe field name (e.g. 'status', 'city').
        limit: Maximum distinct values to return.

    Note: computed from up to 1,000 records — an approximation on
    larger tables.
    """
    if field not in _{{ table.name }}_fields:
        raise ValueError(f"Invalid field: {field}. Available: {', '.join(_{{ table.name }}_fields)}")
    original = _{{ table.name }}_fields[field]
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])
    seen = []
    for record in tbl.all(fields=[original], max_records=1000):
        v = record.get("fields", {}).get(original)
        if isinstance(v, list):
            candidates = v
        else:
            candidates = [v]
        for c in candidates:
            if c not in seen:
                seen.append(c)
                if len(seen) >= limit:
                    return seen
    return seen

@mcp.tool()
def aggregate_{{ table.name }}(group_by: str, agg_function: str = "count", agg_field: str | None = None, limit: int = 20) -> list[dict]:
    """Aggregate '{{ table.description }}' records grouped by a field.

    Args:
        group_by: Safe field name to group by.
        agg_function: 'count', 'sum', 'avg', 'min', or 'max'.
        agg_field: Safe field name to aggregate (required for sum/avg/min/max).
        limit: Maximum groups to return.

    Note: computed from up to 1,000 records — an approximation on
    larger tables.
    """
    if group_by not in _{{ table.name }}_fields:
        raise ValueError(f"Invalid group_by: {group_by}. Available: {', '.join(_{{ table.name }}_fields)}")
    agg_function = agg_function.lower()
    if agg_function not in ("count", "sum", "avg", "min", "max"):
        raise ValueError(f"Invalid agg_function: {agg_function}. Use: count, sum, avg, min, max")
    if agg_function != "count" and not agg_field:
        raise ValueError(f"agg_field is required for {agg_function}")
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])
    groups: dict = {}
    for record in tbl.all(max_records=1000):
        normalized = _normalize_{{ table.name }}(record)
        key = normalized.get(group_by)
        if isinstance(key, list):
            key = ", ".join(str(k) for k in key)
        if agg_function == "count":
            groups[key] = groups.get(key, 0) + 1
        else:
            try:
                num = float(normalized.get(agg_field))
            except (TypeError, ValueError):
                continue
            groups.setdefault(key, []).append(num)

    results = []
    for key, val in groups.items():
        if agg_function == "count":
            value = val
        elif agg_function == "sum":
            value = sum(val)
        elif agg_function == "avg":
            value = sum(val) / len(val) if val else None
        elif agg_function == "min":
            value = min(val) if val else None
        else:
            value = max(val) if val else None
        results.append({"group": key, "value": value})
    results.sort(key=lambda r: (r["value"] is None, r["value"]), reverse=True)
    return results[:min(limit, 100)]
{% endif %}


@mcp.tool()
def filter_{{ table.name }}(formula: str, limit: int = {{ default_limit }}) -> list[dict]:
    """Filter records from '{{ table.description }}' using an Airtable formula.

    This is THE most powerful query tool — it uses Airtable's native formula
    language for precise filtering. Use ORIGINAL Airtable field names in formulas.

    Args:
        formula: An Airtable formula string. Examples:
            - '{Status} = "Active"'
            - 'AND({Age} > 25, {City} = "NYC")'
            - 'FIND("python", LOWER({Skills}))'
            - '{Created} > "2024-01-01"'
            - 'NOT({Email} = BLANK())'
            - 'OR({Priority} = "High", {Priority} = "Critical")'
        limit: Maximum results (default: {{ default_limit }}, max: {{ max_limit }}).

    Available fields (safe_name -> Airtable name):
        {% for col in table.columns %}
        {{ col.name }} -> {{ col.description }}
        {% endfor %}
    """
    limit = min(limit, {{ max_limit }})
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])
    records = tbl.all(formula=formula, max_records=limit)
    return [_normalize_{{ table.name }}(r) for r in records]



{% if 'read' in tbl_ops %}
@mcp.tool()
def count_{{ table.name }}() -> int:
    """Get the total number of records in '{{ table.description }}'."""
    tbl = base.table(TABLE_NAMES["{{ table.name }}"])
    # Fetch only record IDs (no field data) to minimize API payload
    count = 0
    for page in tbl.iterate(fields=[]):
        count += len(page)
    return count
